rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions: Strict Attribute-Based Access Control via verified /authUidMap/{uid} document
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/authUidMap/$(request.auth.uid)).data;
    }

    function hasAuthMap() {
      return isAuthenticated() && exists(/databases/$(database)/documents/authUidMap/$(request.auth.uid));
    }

    function isAppVirtualEmail() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.matches('.*\\.eljur\\.org$');
    }

    function isLoginLookup() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.matches('^login_lookup(@|_[a-z0-9]+@)school1\\.eljur\\.org$');
    }

    function isCreator() {
      return isAuthenticated() && (
        request.auth.uid == 'P5cdPdwZSOXcKzpKLsPWRsoY7CM2' ||
        request.auth.token.email == 'dmitrijkarasev14312@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('^creator(@|_[a-z0-9]+@)global\\.eljur\\.org$')) ||
        (hasAuthMap() && currentUserData().get('role', '') == 'creator')
      );
    }

    function isSchoolMember(schoolId) {
      return isAuthenticated() && (
        isCreator() ||
        isAppVirtualEmail() ||
        (hasAuthMap() && currentUserData().get('schoolId', '') == schoolId)
      );
    }

    function isDirector(schoolId) {
      return isAuthenticated() && (
        isCreator() ||
        (hasAuthMap() && 
         currentUserData().get('schoolId', '') == schoolId &&
         currentUserData().get('role', '') == 'director')
      );
    }

    function isEmployee(schoolId) {
      return isAuthenticated() &&
        hasAuthMap() &&
        currentUserData().get('schoolId', '') == schoolId &&
        currentUserData().get('role', '') == 'employee';
    }

    function isTeacher(schoolId) {
      return isDirector(schoolId) || isEmployee(schoolId) || (
        isAuthenticated() &&
        hasAuthMap() &&
        currentUserData().get('schoolId', '') == schoolId &&
        currentUserData().get('role', '') == 'teacher'
      );
    }

    // Mapping table: user can read and update their own map doc or creator can inspect.
    match /authUidMap/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isCreator());

      allow create, update: if isAuthenticated() && (
        isCreator() ||
        (
          request.auth.uid == uid &&
          request.resource.data.keys().hasAll(['schoolId', 'userId', 'role'])
        )
      );

      allow delete: if isCreator() || (hasAuthMap() && isDirector(resource.data.schoolId));
    }

    // --- Isolated School Namespace (Multi-Tenant Isolation) ---
    match /schools/{schoolId} {
      // Public Creator Gate Configuration (pre-login trigger configuration and password verification hash)
      match /publicConfig/creatorGate {
        allow read: if true;
        allow write: if isDirector(schoolId);
      }

      // School metadata/settings: members of THIS school, login lookup, or creator can read
      allow read: if isSchoolMember(schoolId) || isLoginLookup();
      // Directors or authorized employees of THIS school or creator can update school metadata/settings
      allow write: if isDirector(schoolId) || isEmployee(schoolId);

      // School users collection (Profiles)
      match /users/{userId} {
        allow read: if isSchoolMember(schoolId) || isLoginLookup();
        allow write: if isCreator() || (
          (isDirector(schoolId) || isEmployee(schoolId)) && (
            request.method == 'delete' ||
            request.resource.data.role != 'creator'
          )
        ) || (
          isAuthenticated() &&
          hasAuthMap() &&
          currentUserData().get('schoolId', '') == schoolId &&
          currentUserData().get('userId', '') == userId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('authUid', '') == resource.data.get('authUid', '') &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id', 'role', 'schoolId', 'authUid', 'isAdministration', 'canSendAsDirector', 
            'allowedTabs', 'messagingScope', 'blockedUntil', 
            'teacherClasses', 'employeePermissions', 'classes', 'subjects'
          ])
        );
      }

      // Class schedules: teachers/employees of this school or director/creator can manage
      match /schedules/{classKey} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isTeacher(schoolId);
      }

      // Academic Grades - CRITICAL: Students NEVER write grades
      match /grades/{gradeId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isTeacher(schoolId);
      }

      // Final Grades
      match /finalGrades/{classKey} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isTeacher(schoolId);
      }

      // Homework assignments
      match /homework/{hwId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isTeacher(schoolId);
      }

      // Internal School Messaging
      match /messages/{msgId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if isSchoolMember(schoolId);
        allow update: if isDirector(schoolId) || isEmployee(schoolId) || (
          hasAuthMap() && (
            currentUserData().get('role', '') == 'director' ||
            currentUserData().get('role', '') == 'employee'
          )
        ) || (
          isSchoolMember(schoolId) && (
            resource.data.fromId == currentUserData().get('userId', '') ||
            resource.data.get('realAuthorId', '') == currentUserData().get('userId', '') ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy', 'readBeforeEditBy', 'readAfterEditBy', 'schoolId'])
          )
        );
        allow delete: if isDirector(schoolId) || isEmployee(schoolId) || (
          hasAuthMap() && (
            currentUserData().get('role', '') == 'director' ||
            currentUserData().get('role', '') == 'employee'
          )
        ) || (
          isSchoolMember(schoolId) && (
            resource.data.fromId == currentUserData().get('userId', '') ||
            resource.data.get('realAuthorId', '') == currentUserData().get('userId', '')
          )
        );
      }

      // School Announcements
      match /announcements/{annId} {
        allow read: if isSchoolMember(schoolId);
        allow create, delete: if isDirector(schoolId) || isEmployee(schoolId);
        allow update: if isDirector(schoolId) || isEmployee(schoolId) || (
          isSchoolMember(schoolId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy', 'readBeforeEditBy', 'readAfterEditBy', 'schoolId'])
        );
      }

      // Teacher load assignments
      match /teacherAssignments/{assignId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isDirector(schoolId) || isEmployee(schoolId);
      }

      // Student subgroups
      match /studentGroups/{groupId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isDirector(schoolId) || isEmployee(schoolId);
      }

      // Shared file attachments (all school members can read and upload attachments)
      match /attachments/{attachmentId} {
        allow read: if isSchoolMember(schoolId) || (isAuthenticated() && schoolId == 'global');
        allow write: if isSchoolMember(schoolId) || (isAuthenticated() && schoolId == 'global');
      }
    }
  }
}
